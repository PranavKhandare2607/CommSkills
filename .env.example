# ---- Local AI (Ollama) ----
# The API container reaches host Ollama via host.docker.internal.
# Run `ollama list` and set LLM_CHAT_MODEL to an installed tag.
# For CPU-only machines prefer a small instruct model, e.g. qwen2.5:7b-instruct.
# Fast CPU model. Create it once with `pnpm run setup:local-model` (pulls
# qwen2.5:1.5b-instruct and pins num_ctx=4096). The old 30B coder model was
# ~20x slower on CPU and is no longer used.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=ollama
LLM_CHAT_MODEL=commskills-turbo
LLM_REQUEST_TIMEOUT_MS=120000

# Billing is disabled locally: unlock every premium feature for all users.
# Set to false to test the free trial / paywall flow.
LOCAL_PREMIUM_MODE=true

# ---- Sessions ----
SESSION_COOKIE_NAME=commskills_session
SESSION_TTL_DAYS=30
# Set to "true" only if serving over HTTPS
COOKIE_SECURE=false

# ---- STT / TTS ----
STT_BASE_URL=http://stt:8080
TTS_BASE_URL=http://tts:8080
STT_TIMEOUT_MS=120000
TTS_TIMEOUT_MS=30000
# "small" improves English accuracy over "base" with reasonable CPU latency.
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# Beam search (5) improves accuracy; lower to 1 for a faster CPU machine.
STT_BEAM_SIZE=5
TTS_VOICE_EN=en_US-amy-medium
TTS_VOICE_HI=hi_IN-priyamvada-medium

# ---- Database ----
DATABASE_URL=postgresql://commskills:commskills@db:5432/commskills

# ---- Server / local frontend dev ----
PORT=8080
LOG_LEVEL=info
# Used by `pnpm dev` in artifacts/communication-skills (non-Docker frontend).
VITE_API_PROXY_TARGET=http://localhost:8080
